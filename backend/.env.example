# Copy to .env and fill in. Never commit .env. None of these values are exposed to the frontend.

APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence: one SQLite database file, created on first start (with its folder). A relative path is relative
# to the folder the API is started from. The Docker image uses sqlite:////data/sitesurelabs.db on a volume.
DATABASE_URL=sqlite:///./sitesurelabs.db

# --- Abuse protection ---
RATE_LIMIT_MAX=5                    # submissions per window per IP
RATE_LIMIT_WINDOW_SECONDS=600
MIN_FILL_SECONDS=3                  # forms submitted faster than this are rejected
REQUIRE_BUSINESS_EMAIL=true         # reject gmail.com, outlook.com etc.
TRUST_PROXY_HEADERS=false           # true ONLY behind a reverse proxy you control (reads X-Forwarded-For)
IP_HASH_SALT=replace-with-a-long-random-string   # required in production
TURNSTILE_SECRET_KEY=               # optional: Cloudflare Turnstile secret (pair with VITE_TURNSTILE_SITE_KEY)

# --- Notifications (optional). Enquiries are always stored first. ---
NOTIFY_TO=
NOTIFY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
WEBHOOK_URL=                        # optional CRM / automation webhook (receives a JSON POST per enquiry)

# --- Admin read access (optional) ---
# Set to a long random token to enable GET /api/admin/enquiries (Authorization: Bearer <token>)
ADMIN_TOKEN=
