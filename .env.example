# Used by docker-compose.yml. Copy to .env (never commit it). The backend's own variables are documented in backend/.env.example.
# Keep every comment on its own line. Docker Compose reads "KEY=   # note" as the value "# note", not as an empty value.

IP_HASH_SALT=replace-with-a-long-random-string
# The origin the browser loads the site from (used for CORS)
PUBLIC_ORIGIN=https://sitesurelabs.com
# The site is published on http://localhost:<WEB_PORT>. Use a port no other program listens on: on Windows another
# server can hold the IPv4 side of a port Docker publishes, and the browser then gets some files from that server.
WEB_PORT=8080

# Optional. An empty value turns the feature off.
# A long random token enables GET /api/admin/enquiries (Authorization: Bearer <token>)
ADMIN_TOKEN=
NOTIFY_TO=
NOTIFY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
WEBHOOK_URL=
# Cloudflare Turnstile: the server secret, and the public site key (baked into the frontend build). Set both or neither.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
