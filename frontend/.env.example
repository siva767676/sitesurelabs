# Frontend build-time variables. Only VITE_* values are exposed to the browser: never put secrets here.

# Base URL of the FastAPI backend. Leave empty to use same-origin /api (dev proxy or reverse proxy).
VITE_API_URL=

# Optional Cloudflare Turnstile *site* key (public). Pair with TURNSTILE_SECRET_KEY on the backend.
VITE_TURNSTILE_SITE_KEY=
