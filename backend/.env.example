# Copy to .env and fill in. Never commit .env. None of these values are exposed to the frontend.

APP_ENV=development                 # development | production | test
LOG_LEVEL=INFO

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Persistence: one SQLite database file, created on first start (with its folder). A relative path is relative
# to the folder the API is started from. The Docker image uses sqlite:////data/sitesurelabs.db on a volume.
DATABASE_URL=sqlite:///./sitesurelabs.db

# --- Abuse protection ---
RATE_LIMIT_MAX=5                    # submissions per window per IP
RATE_LIMIT_WINDOW_SECONDS=600
MIN_FILL_SECONDS=3                  # forms submitted faster than this are rejected
REQUIRE_BUSINESS_EMAIL=true         # reject gmail.com, outlook.com etc.
TRUST_PROXY_HEADERS=false           # true ONLY behind a reverse proxy you control (reads X-Forwarded-For)
IP_HASH_SALT=replace-with-a-long-random-string   # required in production
TURNSTILE_SECRET_KEY=               # optional: Cloudflare Turnstile secret (pair with VITE_TURNSTILE_SITE_KEY)

# --- Notifications (optional). Enquiries are ALWAYS stored first; e-mail is sent afterwards. ---
# Where enquiries are e-mailed. Several addresses: separate them with commas.
NOTIFY_TO=
# Sender. Must be an address at a domain your mail service has verified (Amazon SES: sitesurelabs.com is verified).
# Leave empty to use SiteSureLabs <noreply@sitesurelabs.com>.
NOTIFY_FROM=
# SMTP server. Leave SMTP_HOST empty to send nothing.
#   Development (nothing real is sent): docker compose -f docker-compose.dev.yml up -d mailpit, then
#       SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_STARTTLS=false   and read the mail at http://localhost:8025
#   Production (Amazon SES, Mumbai): SMTP_HOST=email-smtp.ap-south-1.amazonaws.com  SMTP_PORT=587
#       with the SES SMTP username and password (see docs/EMAIL_NOTIFICATIONS.md; use deploy/enable-email-notifications.sh)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true                  # ports other than 465 upgrade with STARTTLS and check the certificate; 465 uses implicit TLS
WEBHOOK_URL=                        # optional CRM / automation webhook (receives a JSON POST per enquiry)

# --- Admin read access (optional) ---
# Set to a long random token to enable GET /api/admin/enquiries (Authorization: Bearer <token>)
ADMIN_TOKEN=
