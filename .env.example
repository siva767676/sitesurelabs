# Used by docker-compose.yml. Copy to .env (never commit it). The backend's own variables are documented in backend/.env.example.

POSTGRES_PASSWORD=replace-with-a-strong-password
IP_HASH_SALT=replace-with-a-long-random-string
PUBLIC_ORIGIN=https://sitesurelabs.com      # origin the browser loads the site from (used for CORS)
WEB_PORT=8080

# Optional
ADMIN_TOKEN=                                # enables GET /api/admin/enquiries
NOTIFY_TO=
NOTIFY_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
WEBHOOK_URL=
TURNSTILE_SECRET_KEY=                       # server secret
VITE_TURNSTILE_SITE_KEY=                    # public site key, baked into the frontend build
